---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getBusiness, siteMode } from '../lib/site.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  /** home | service | location | combo | guide | index | contact | legal | 404 — verify.mjs checks each type */
  pageType: string;
  crumbs?: Crumb[];
  jsonLd?: object[];
  guideType?: string;
}
const { title, description, pageType, crumbs = [], jsonLd = [], guideType } = Astro.props;
const b = getBusiness();
const mode = siteMode();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (href: string) => new URL(href, Astro.site).href;
const breadcrumbLd = crumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
} : null;
const ld = [...jsonLd, ...(breadcrumbLd ? [breadcrumbLd] : [])];
const tokens = `--ink:${b.brand.ink};--paper:${b.brand.paper};--accent:${b.brand.accent};--accent-ink:${b.brand.accentInk}`;
---
<!doctype html>
<html lang="en" style={tokens}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {mode === 'preview' && <meta name="robots" content="noindex, nofollow" />}
    <meta name="nsl:page" content={pageType} />
    {guideType && <meta name="nsl:guide-type" content={guideType} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType === 'guide' ? 'article' : 'website'} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header />
    <main id="main">
      {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
